# 复制本文件为 .env，然后填入你的真实配置（.env 不要提交到 git）
# 任何 OpenAI 兼容服务都可用，只需改下面三项。

# DeepSeek 示例（OpenAI 兼容；官方当前推荐 base_url 不带 /v1，模型名用 deepseek-flash）：
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 其它常见兼容地址参考：
# OpenAI:    https://api.openai.com/v1  model=gpt-4o
# Moonshot:  https://api.moonshot.cn/v1  model=moonshot-v1-8k
# 通义:      https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
# 本地:      http://127.0.0.1:11434/v1  model=llama3

# 可选参数：
# LLM_TEMPERATURE=0
# LLM_MAX_TOOL_ROUNDS=8

# —— 知识库检索后端（可选）——
# EMBEDDER_BACKEND=tfidf      # 默认：离线关键词检索（含中文），免下载、确定性
# EMBEDDER_BACKEND=semantic   # 语义检索：需安装 sentence-transformers 并下载模型
# EMBEDDER_MODEL=BAAI/bge-small-zh-v1.5
# 国内下载模型建议走镜像：
# HF_ENDPOINT=https://hf-mirror.com
